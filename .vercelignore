_archive
_artwork
.freebuff
.deepeval
artifacts
design-system
.extract-design-system
text_*.json

# Editor / OS cruft
.DS_Store
Thumbs.db
desktop.ini
.idea
.vscode
*.swp
*.swo
*~
*.log
npm-debug.log*
yarn-error.log*
